# PostgreSQL connection string used by the app and Prisma migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/courier?schema=public"

# Set to a long random value when session authentication is configured.
AUTH_SECRET="replace-this-example-with-a-random-secret-of-32-characters-or-more"

# Comma-separated user IDs permitted to view and triage support disputes.
COURIER_SUPPORT_USER_IDS=""

# Application origin used when constructing absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP settings used for email verification and password recovery.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Courier <no-reply@example.com>"
